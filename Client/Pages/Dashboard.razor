@page "/"
@inject BudgetReportService _reportServ

<PageTitle>Dashboard</PageTitle>

@if (reports == null)
{
    <p><em>@message</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th style="word-wrap: break-word; width: 200px;" align="center">
                    <button type="button" class="btn btn-submit"><a class="text-white" href="/detailedview"><b>View with Buckets</b></a></button>
                </th>
                @foreach (var delt in deltas)
                {
                    @if (delt.BucketLabel == "TOTAL")
                    {
                        <th align="center">OVER/UNDER</th>
                    }
                }
                <th align="center">Budgeted</th>
                <th align="center">Total Spent</th>
                <th align="center"></th>
                <th align="center">Income</th>
                @foreach (var ct in CardTotals)
                {
                    <th align="center">@ct.Key</th>
                }
            </tr>
@*             <tr>
                <th style="word-wrap: break-word; width: 200px;" align="left"></th>
                @foreach (var delt in deltas)
                {
                    @if (delt.BucketLabel == "TOTAL")
                    {
                        <th align="center">@delt.Budget</th>
                    }
                }
                <th align="center"></th>
                <th align="center"></th>
                <th align="center"></th>
                <th align="center"></th>
                @foreach (var ct in CardTotals)
                {
                    <th align="center"></th>
                }
            </tr> *@
        </thead>
        <tbody>

            @foreach (SpendingReportDTO rep in reports)
            {
                <tr>
                    <td align="left" style="word-wrap: break-word; width: 200px;">
                        <a @onclick="() => RedirectPage(rep)">@rep.Period</a>
                    </td>
                    @foreach (var delt in rep.Deltas)
                    {
                        @if (delt.BucketLabel == "TOTAL")
                        {
                            <td class=@(delt.Delta > 0 ? "amount over_budget" : "amount on_budget" ) align="right">
                                @delt.Delta
                            </td>
                        }
                    }
                    @{
                        List<string> allCards = CardTotals.Keys.ToList();
                        List<decimal> vals = new List<decimal>();
                        decimal totalSpend = 0;

                        for (int i = 0; i < allCards.Count(); i++)
                        {
                            decimal amount;
                            if (rep.CardTotals.TryGetValue(allCards[i], out amount))
                            {
                                vals.Add(amount);
                                totalSpend += amount;
                            }
                            else
                            {
                                vals.Add(0);
                            }
                        }

                        // foreach (var ct in rep.CardTotals)
                        // {
                        //     vals.Add(ct.Value);
                        //     totalSpend += @ct.Value;
                        // }
                    }
                    <td class="amount" align="right">@rep.Budgeted</td>
                    <td class="amount" align="right">@totalSpend</td>
                    <td align="right"></td>
                    <td class="amount" align="right">@rep.Income</td>
                    @foreach (var cardTotalVal in vals)
                    {
                        <td class="amount" align="right">@cardTotalVal</td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <Modal @ref="modal" Size="ModalSize.ExtraLarge" />
}

@code {
    private List<SpendingReportDTO> reports;
    private List<SpendingBucketResultDTO> deltas;
    private Dictionary<string, decimal> CardTotals;
    private Modal modal = default!;

    private string message = "Loading...";

    protected override async Task OnInitializedAsync()
    {
        var response = await _reportServ.getReports();

        if (response != null && response.IsSuccess)
        {
            reports = response.Data;
            CardTotals = reports[0].CardTotals;
            deltas = reports[0].Deltas;
        }
        else
            message = response?.Message;
    }

    private async Task RedirectPage(SpendingReportDTO rep, SpendingBucketResultDTO? delta = null)
    {
        if (!rep.Period.Contains("Average") && delta?.BucketLabel != "TOTAL")
        {
            var parameters = new Dictionary<string, object>();
            parameters.Add("Report", rep);
            string title = rep.Period;
            if (delta?.BucketLabel != null)
            {
                string bal = delta.Delta >= 0 ? "over" : "under";
                title += $" {delta.BucketLabel} : ${delta.Budget} budgeted / ${delta.Delta} {bal} budget";
                parameters.Add("BucketLabel", delta.BucketLabel);
            }

            await modal.ShowAsync<MonthlySummaryPopup>(title: title, parameters: parameters);
        }
    }

    //https://htmlcolorcodes.com/color-picker/
    //Green - #4DC637
    //Orange - #C66937
    //Purple - #B037C6
        //Blue - #3794C6
}

