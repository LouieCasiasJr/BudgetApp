@page "/transactionview"
@page "/transactionview/{Period}"
@page "/transactionview/{Period}/{BucketLabel}"
@inject TransactionService _tranServ

<PageTitle>Transaction View</PageTitle>

@if (Display == null)
{
    <p><em>@message</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th align="center"></th>
                <th align="center">Date</th>
                <th align="center">Card</th>
                <th align="center">Description</th>
                <th align="center">Amount</th>
                <th align="center">Reference</th>
                <th align="center">Bucket</th>
                <th align="center">Priority</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rep in Display)
            {
                <tr>
                    <td align="left">@counter</td>
                    <td align="left">@rep.TransactionDate</td>
                    <td align="left">@rep.Card</td>
                    <td align="left">@rep.Description</td>
                    <td class="amount" align="right">@rep.Amount</td>
                    <td align="left">@rep.Reference</td>
                    <td align="left">@rep.BucketLabel</td>
                    <td align="left">@rep.Priority</td>
                </tr>
                counter++;
            }
        </tbody>
    </table>
}

@code {
    public IEnumerable<TransactionDisplayDTO>? Display = new List<TransactionDisplayDTO>();
    private string message = "Loading...";
    private int counter = 1;
    private DateOnly From;
    private DateOnly To;

    [Parameter]
    public string? Period { get; set; }

    [Parameter]
    public string? BucketLabel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Period != null)
        {
            int i = Period.Length - 2;
            string p = Period.Insert(i, "1 ");
            From = DateOnly.ParseExact(p, "MMMM d yy");
            To = From.AddMonths(1).AddDays(-1);
        }

        var resp = await _tranServ.getAllTransactionDisplays(From.ToString("MM/dd/yyyy"), To.ToString("MM/dd/yyyy"), BucketLabel);

        Display = resp.Data;

        base.OnInitialized();
    }
}